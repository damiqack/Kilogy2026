{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "no-unused-vars": "warn",
    "react/react-in-jsx-scope": "off",
    "react/set-state-in-effect": "off",
    "react/immutability": "off",
    "react/purity": "off"
  },
  "env": {
    "browser": true,
    "es2022": true
  }
}
